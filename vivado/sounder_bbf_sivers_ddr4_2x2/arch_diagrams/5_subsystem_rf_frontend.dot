digraph "rf_frontend" {
  graph [rankdir=LR, splines=ortho, nodesep=0.32, ranksep=0.55, fontname="Helvetica",
         bgcolor="white", compound=true, labelloc="t", fontsize=20, forcelabels=true,
         pack=false, label=<<b>Subsystem — RF Front-End (usp_rf_data_converter_0)</b>>];
  node  [fontname="Helvetica", fontsize=11, shape=box, style="filled,rounded", penwidth=1.3];
  edge  [fontname="Helvetica", fontsize=9, penwidth=1.4, arrowsize=0.7];
  subgraph "cluster_adc_in" {
    label=<<b>ADC Analog In</b>>; fontsize=13; style="rounded"; color="#8E44AD"; bgcolor="#F4ECF7"; penwidth=1.5; margin=12;
  "v001" [label="vin0_01", shape=cds, fillcolor="#FFFFFF", color="#666666", style="filled", fontsize=10];
  "v023" [label="vin0_23", shape=cds, fillcolor="#FFFFFF", color="#666666", style="filled", fontsize=10];
  "v201" [label="vin2_01", shape=cds, fillcolor="#FFFFFF", color="#666666", style="filled", fontsize=10];
  "v223" [label="vin2_23", shape=cds, fillcolor="#FFFFFF", color="#666666", style="filled", fontsize=10];
  }
  subgraph "cluster_clkin" {
    label=<<b>Sample Clocks / SYSREF</b>>; fontsize=13; style="rounded"; color="#8E44AD"; bgcolor="#F4ECF7"; penwidth=1.5; margin=12;
  "a0" [label="adc0_clk", shape=cds, fillcolor="#FFFFFF", color="#666666", style="filled", fontsize=10];
  "a2" [label="adc2_clk", shape=cds, fillcolor="#FFFFFF", color="#666666", style="filled", fontsize=10];
  "d0" [label="dac0_clk", shape=cds, fillcolor="#FFFFFF", color="#666666", style="filled", fontsize=10];
  "d1" [label="dac1_clk", shape=cds, fillcolor="#FFFFFF", color="#666666", style="filled", fontsize=10];
  "sr" [label="sysref_in", shape=cds, fillcolor="#FFFFFF", color="#666666", style="filled", fontsize=10];
  }
  "usp_rf_data_converter_0" [shape=plaintext, label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="4" bgcolor="white"><tr><td colspan="2" bgcolor="#8E44AD"><font color="white" point-size="11"><b>usp_rf_data_converter_0  (RFDC 2.6)</b></font></td></tr><tr><td port="vin" align="left" bgcolor="#E1D5E7"><font point-size="10">vin0_01/23, vin2_01/23</font></td><td port="m00" align="right" bgcolor="#E1D5E7"><font point-size="10">m00_axis</font></td></tr><tr><td port="s00" align="left" bgcolor="#E1D5E7"><font point-size="10">s00_axis</font></td><td port="m20" align="right" bgcolor="#E1D5E7"><font point-size="10">m20_axis</font></td></tr><tr><td port="s10" align="left" bgcolor="#E1D5E7"><font point-size="10">s10_axis</font></td><td port="vout" align="right" bgcolor="#E1D5E7"><font point-size="10">vout00..03 / 10..13</font></td></tr><tr><td port="saxi" align="left" bgcolor="#E1D5E7"><font point-size="10">s_axi (Lite)</font></td><td port="irq" align="right" bgcolor="#E1D5E7"><font point-size="10">irq</font></td></tr><tr><td colspan="2" port="smpclk" align="left" bgcolor="#E1D5E7"><font point-size="10">adc/dac sample clk</font></td></tr><tr><td port="sysref" align="left" bgcolor="#E1D5E7"><font point-size="10">user_sysref_adc/dac</font></td><td port="aclk" align="right" bgcolor="#E1D5E7"><font point-size="10">axis aclk (rf_clk)</font></td></tr></table>>];
  subgraph "cluster_dac_out" {
    label=<<b>DAC Analog Out</b>>; fontsize=13; style="rounded"; color="#8E44AD"; bgcolor="#F4ECF7"; penwidth=1.5; margin=12;
  "o00" [label="vout00..03", shape=invhouse, fillcolor="#FFFFFF", color="#666666", style="filled", fontsize=10];
  "o10" [label="vout10..13", shape=invhouse, fillcolor="#FFFFFF", color="#666666", style="filled", fontsize=10];
  }
  "adc_path" [label="adc_path\n(ADC0/ADC1 AXIS out)", shape=box, fillcolor="#DAE8FC", color="#1F6FC4"];
  "dac_path" [label="dac_path\n(DAC0/DAC1 AXIS in)", shape=box, fillcolor="#DAE8FC", color="#1F6FC4"];
  "clocktreeMTS" [label="clocktreeMTS\n(rf_clk + user_sysref)", shape=box, fillcolor="#FFF2CC", color="#C99A00"];
  "ps8_axi_periph" [label="ps8_axi_periph\n(M02 -> s_axi)", shape=box, fillcolor="#D5E8D4", color="#2E8B57"];
  "irq_concat" [label="irq_concat\n(irq In0)", shape=box, fillcolor="#D5E8D4", color="#2E8B57"];
  "tieoff" [label="xlconstant_0/1/2\n(unused s0x/s1x tie-off)", shape=box, fillcolor="#EEEEEE", color="#AAAAAA"];
  "v001" -> "usp_rf_data_converter_0":"vin":w [color="#1F6FC4", style="solid", penwidth=2.0, arrowhead=normal];
  "v023" -> "usp_rf_data_converter_0":"vin":w [color="#1F6FC4", style="solid", penwidth=2.0, arrowhead=normal];
  "v201" -> "usp_rf_data_converter_0":"vin":w [color="#1F6FC4", style="solid", penwidth=2.0, arrowhead=normal];
  "v223" -> "usp_rf_data_converter_0":"vin":w [color="#1F6FC4", style="solid", penwidth=2.0, arrowhead=normal];
  "usp_rf_data_converter_0":"m00":e -> "adc_path" [color="#1F6FC4", style="solid", penwidth=2.0, arrowhead=normal, xlabel="m00_axis", fontcolor="#1F6FC4"];
  "usp_rf_data_converter_0":"m20":e -> "adc_path" [color="#1F6FC4", style="solid", penwidth=2.0, arrowhead=normal, xlabel="m20_axis", fontcolor="#1F6FC4"];
  "dac_path" -> "usp_rf_data_converter_0":"s00":w [color="#1F6FC4", style="solid", penwidth=2.0, arrowhead=normal, xlabel="s00_axis", fontcolor="#1F6FC4"];
  "dac_path" -> "usp_rf_data_converter_0":"s10":w [color="#1F6FC4", style="solid", penwidth=2.0, arrowhead=normal, xlabel="s10_axis", fontcolor="#1F6FC4"];
  "usp_rf_data_converter_0":"vout":e -> "o00" [color="#1F6FC4", style="solid", penwidth=2.0, arrowhead=normal];
  "usp_rf_data_converter_0":"vout":e -> "o10" [color="#1F6FC4", style="solid", penwidth=2.0, arrowhead=normal];
  "a0" -> "usp_rf_data_converter_0":"smpclk":w [color="#C99A00", style="dashed", penwidth=1.3, arrowhead=vee];
  "a2" -> "usp_rf_data_converter_0":"smpclk":w [color="#C99A00", style="dashed", penwidth=1.3, arrowhead=vee];
  "d0" -> "usp_rf_data_converter_0":"smpclk":w [color="#C99A00", style="dashed", penwidth=1.3, arrowhead=vee];
  "d1" -> "usp_rf_data_converter_0":"smpclk":w [color="#C99A00", style="dashed", penwidth=1.3, arrowhead=vee];
  "sr" -> "usp_rf_data_converter_0":"sysref":w [color="#C99A00", style="dashed", penwidth=1.3, arrowhead=vee, xlabel="sysref_in", fontcolor="#C99A00"];
  "clocktreeMTS" -> "usp_rf_data_converter_0":"aclk":e [color="#C99A00", style="dashed", penwidth=1.3, arrowhead=vee, xlabel="rf_clk", fontcolor="#C99A00"];
  "clocktreeMTS" -> "usp_rf_data_converter_0":"sysref":w [color="#C99A00", style="dashed", penwidth=1.3, arrowhead=vee, xlabel="user_sysref", fontcolor="#C99A00"];
  "ps8_axi_periph" -> "usp_rf_data_converter_0":"saxi":w [color="#2E8B57", style="solid", penwidth=1.4, arrowhead=normal, xlabel="s_axi", fontcolor="#2E8B57"];
  "usp_rf_data_converter_0":"irq":e -> "irq_concat" [color="#8E44AD", style="dashed", penwidth=1.3, arrowhead=vee, xlabel="irq", fontcolor="#8E44AD"];
  "tieoff" -> "usp_rf_data_converter_0":"s10":w [color="#555555", style="solid", penwidth=1.1, arrowhead=normal, xlabel="s01/02/03 s11/12/13", fontcolor="#555555"];
  "legend" [shape=plaintext, margin=0, label=<<table border="1" color="#777777" cellborder="0" cellspacing="4" cellpadding="2" bgcolor="white"><tr><td colspan="4" align="center"><font point-size="12"><b>Legend</b></font></td></tr><tr><td bgcolor="#DAE8FC" width="26"><font point-size="4"> </font></td><td align="left"><font point-size="10">Data plane</font></td><td align="right"><font color="#1F6FC4" point-size="13"><b>———</b></font></td><td align="left"><font point-size="10">AXI-Stream</font></td></tr><tr><td bgcolor="#D5E8D4" width="26"><font point-size="4"> </font></td><td align="left"><font point-size="10">Control plane</font></td><td align="right"><font color="#B85450" point-size="13"><b>———</b></font></td><td align="left"><font point-size="10">AXI-MM data</font></td></tr><tr><td bgcolor="#FFF2CC" width="26"><font point-size="4"> </font></td><td align="left"><font point-size="10">Clocking / sync</font></td><td align="right"><font color="#2E8B57" point-size="13"><b>———</b></font></td><td align="left"><font point-size="10">AXI-Lite ctrl</font></td></tr><tr><td bgcolor="#E1D5E7" width="26"><font point-size="4"> </font></td><td align="left"><font point-size="10">RF front-end</font></td><td align="right"><font color="#C99A00" point-size="13"><b>– – –</b></font></td><td align="left"><font point-size="10">clock</font></td></tr><tr><td bgcolor="#F8CECC" width="26"><font point-size="4"> </font></td><td align="left"><font point-size="10">DDR memory</font></td><td align="right"><font color="#B85450" point-size="13"><b>······</b></font></td><td align="left"><font point-size="10">reset</font></td></tr><tr><td bgcolor="#FFE6CC" width="26"><font point-size="4"> </font></td><td align="left"><font point-size="10">Processor system</font></td><td align="right"><font color="#8E44AD" point-size="13"><b>– – –</b></font></td><td align="left"><font point-size="10">interrupt</font></td></tr></table>>];
}
